# EduIQ Environment Configuration Example
# Copy this file to .env for production database & authentication configuration

# Application Mode (true = Zero-Configuration Local Demo Mode)
VITE_DEMO_MODE=true

# Optional: Supabase Cloud Database & Authentication (Production Mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: OpenAI / AI Provider API Key (Contextual AI Copilot Extension)
VITE_OPENAI_API_KEY=your-openai-api-key-here
